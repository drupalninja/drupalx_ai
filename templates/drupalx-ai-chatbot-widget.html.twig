<!-- Chatbot Toggle Button -->
<div class="drupalx-ai-chatbot-toggle" aria-label="{{ 'Open AI Page Builder'|t }}">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
  </svg>
</div>

<!-- Chatbot Off-Canvas Overlay -->
<div class="drupalx-ai-chatbot-overlay">
  <div class="drupalx-ai-chatbot-sidebar">
    <div class="drupalx-ai-chatbot-header">
      <div class="drupalx-ai-chatbot-title">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="drupalx-ai-chatbot-icon">
          <path d="M12 2a9.9 9.9 0 0 1 7 3 9.9 9.9 0 0 1 3 7 9.9 9.9 0 0 1-3 7 9.9 9.9 0 0 1-7 3 9.9 9.9 0 0 1-7-3 9.9 9.9 0 0 1-3-7 9.9 9.9 0 0 1 3-7 9.9 9.9 0 0 1 7-3Z"></path>
          <path d="M8 12h8"></path>
          <path d="M8 8h8"></path>
          <path d="M8 16h6"></path>
        </svg>
        {{ 'AI Page Builder'|t }}
      </div>
      <button class="drupalx-ai-chatbot-close" aria-label="{{ 'Close chatbot'|t }}" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 6L6 18"></path>
          <path d="M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <div class="drupalx-ai-chatbot-content">
      <div class="drupalx-ai-chatbot-intro">
        <h3>{{ 'Welcome to AI Page Builder'|t }}</h3>
        <p>{{ 'I can help you create beautiful landing pages in seconds. Just describe what you need and I\'ll generate a complete page with components, content, and images.'|t }}</p>
        <div class="drupalx-ai-chatbot-examples">
          <p><strong>{{ 'Try asking:'|t }}</strong></p>
          <ul>
            <li>"{{ 'Create a services page for a consulting company'|t }}"</li>
            <li>"{{ 'Build a landing page for a university'|t }}"</li>
            <li>"{{ 'Make a product showcase page'|t }}"</li>
          </ul>
        </div>
      </div>
      
      <div class="drupalx-ai-chatbot-messages" aria-live="polite">
        <span class="visually-hidden">{{ 'Chat messages will appear here'|t }}</span>
      </div>
    </div>

    <div class="drupalx-ai-chatbot-input">
      <div class="drupalx-ai-chatbot-input-wrapper">
        <input type="text" placeholder="{{ 'Describe the page you want to create...'|t }}" aria-label="{{ 'Chatbot message input'|t }}" />
        <button type="button" aria-label="{{ 'Send message'|t }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m22 2-7 20-4-9-9-4Z"/>
            <path d="M22 2 11 13"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>
